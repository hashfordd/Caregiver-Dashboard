# Vite picks these up at build time. Copy to apps/web/.env.local and fill.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# F9 outdoor map. Provision a token at https://account.mapbox.com/access-tokens/.
# Without a token, the outdoor view renders a "Map unavailable" placeholder
# rather than crashing — the rest of the dashboard works as normal.
VITE_MAPBOX_TOKEN=

# HiveMQ Cloud — direct browser live feed over WebSocket (low-latency vitals).
# The dashboard subscribes straight to the broker; these values ship in the web
# bundle, so use a READ-ONLY credential (SUBSCRIBE on device/# only) created in
# the HiveMQ console — never the read-write 'alzcare' cred the bridge uses.
# Leave username/password blank to disable the feed (falls back to Supabase
# realtime); the rest of the dashboard works as normal.
VITE_MQTT_WSS_URL=wss://YOUR-CLUSTER.s1.eu.hivemq.cloud:8884/mqtt
VITE_MQTT_RO_USERNAME=
VITE_MQTT_RO_PASSWORD=
