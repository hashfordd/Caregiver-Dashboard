# Ingest environment — single config: HiveMQ Cloud broker + HOSTED Supabase.
#
# Copy to `apps/edge/.env` (gitignored) and fill in. Used by `npm run stack:up`
# (bridge + shim) and `npm run bridge:start`. (`supabase functions deploy` reads
# from supabase/.env for cloud deploys; this documents what the ingest expects.)

# Hosted Supabase (service-role key — keep server-side only)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_HOSTED_SERVICE_ROLE_KEY

# HiveMQ Cloud broker (always-on). TLS is required: mqtts:// on port 8883.
# Create a free Serverless cluster + a credential at console.hivemq.cloud.
MQTT_BROKER_URL=mqtts://YOUR-CLUSTER.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=alzcare
MQTT_PASSWORD=YOUR_HIVEMQ_PASSWORD

# Optional: identify this ingest server in the dashboard's status pill
INGEST_SERVER_ID=default
LOG_LEVEL=info
