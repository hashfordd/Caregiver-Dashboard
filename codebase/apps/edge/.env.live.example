# Local ingest server → HOSTED Supabase.
#
# Copy to `apps/edge/.env.live` (gitignored) and fill in the hosted values.
# Used by `npm run stack:live` / `npm run bridge:start:live`: the broker + bridge
# + shim run on this machine but write to the hosted project, so the live
# (Vercel) dashboard shows the data and the "Server online" heartbeat.

# Hosted Supabase (from the project's API settings)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_HOSTED_SERVICE_ROLE_KEY

# Local broker (stays on this machine)
MQTT_BROKER_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=backend-bridge
MQTT_PASSWORD=bridgepass

# Optional: identify this ingest server in the dashboard's status pill
INGEST_SERVER_ID=default
LOG_LEVEL=info
